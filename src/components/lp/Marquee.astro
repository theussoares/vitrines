---
const { items } = Astro.props as { items: string[] };
const loop = [...items, ...items];
---
<div class="relative overflow-hidden border-y border-white/10 bg-white/[.02] py-5 [mask-image:linear-gradient(90deg,transparent,#000_12%,#000_88%,transparent)]" aria-hidden="true">
  <div class="marquee gap-3">
    {loop.map((t) => <span class="mx-3 flex items-center gap-6 whitespace-nowrap font-display text-lg font-semibold text-white/60">{t}<span class="size-1.5 rounded-full bg-brand"></span></span>)}
  </div>
</div>
