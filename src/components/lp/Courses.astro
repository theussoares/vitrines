---
import type { LandingPage } from '../../lib/lp';
import { whatsappUrl } from '../../lib/lp';
import Icon from '../Icon.astro';
const { lp } = Astro.props as { lp: LandingPage };
---
<section id="cursos" class="mx-auto max-w-6xl px-5 py-20">
  <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
    <div class="max-w-xl">
      <p data-reveal class="text-sm font-semibold uppercase tracking-[.2em] text-glow">{lp.ui?.coursesEyebrow ?? 'Cursos profissionalizantes'}</p>
      <h2 data-reveal style="--d:1" class="mt-3 text-4xl font-bold sm:text-5xl">{lp.coursesSection.title}</h2>
    </div>
    <p data-reveal style="--d:2" class="max-w-sm text-white/60">{lp.coursesSection.text}</p>
  </div>
  <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
    {lp.courses.map((c, i) => (
      <a
        data-reveal style={`--d:${i}`}
        href={whatsappUrl(lp, `Olá! Quero saber mais sobre ${c.title}.`)} target="_blank" rel="noopener"
        class={`spot group glass flex min-h-60 flex-col justify-between rounded-3xl p-7 transition-transform duration-500 hover:-translate-y-1 ${i < 2 ? 'lg:col-span-3' : 'lg:col-span-2'}`}
      >
        <div class="flex items-start justify-between">
          <span class="grid size-12 place-items-center rounded-2xl bg-gradient-to-br from-glow to-brand-deep text-white shadow-lg shadow-brand/30"><Icon name={c.icon} class="size-6" /></span>
          <span class="rounded-full border border-white/10 px-3 py-1 text-xs text-white/55">{c.area}</span>
        </div>
        <div class="mt-10">
          <h3 class="text-2xl font-semibold">{c.title}</h3>
          <p class="mt-2 text-white/55">{c.blurb}</p>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-glow">Quero saber mais<Icon name="arrow" class="size-4 transition-transform duration-300 group-hover:translate-x-1.5" /></span>
        </div>
      </a>
    ))}
  </div>
</section>
