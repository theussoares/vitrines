---
import type { LandingPage } from '../../lib/lp';
import { whatsappUrl } from '../../lib/lp';
import Icon from '../Icon.astro';
const { lp } = Astro.props as { lp: LandingPage };
const nav = lp.ui?.nav ?? [['#metodo', 'Metodologia'], ['#cursos', 'Cursos'], ['#caminhos', 'Programas'], ['#faq', 'Dúvidas']];
const cta = lp.ui?.headerCta ?? 'Falar com a secretaria';
---
<header data-header class="group fixed inset-x-0 top-0 z-50 transition-all duration-500 [&.is-scrolled]:py-0">
  <div class="mx-auto mt-3 flex max-w-6xl items-center justify-between gap-4 rounded-full px-4 py-2.5 transition-all duration-500 group-[.is-scrolled]:glass group-[.is-scrolled]:bg-black/50 group-[.is-scrolled]:shadow-2xl sm:px-6">
    <a href="#top" class="flex items-center gap-2.5 font-display font-bold tracking-tight" aria-label={`${lp.brand.name} ${lp.brand.city}`}>
      <span class="relative grid size-9 place-items-center rounded-full bg-brand shadow-[0_0_24px_var(--brand)]">
        <svg viewBox="0 0 64 64" class="size-9" aria-hidden="true"><path d="M12 38c8 14 32 14 42-6-10 4-28 4-42 6z" fill="#fff" opacity=".9" /></svg>
      </span>
      <span class="leading-none">{lp.brand.name}<small class="block text-[10px] font-medium uppercase tracking-[.2em] text-white/50">{lp.brand.city}</small></span>
    </a>
    <nav class="hidden items-center gap-8 text-sm text-white/70 md:flex" aria-label="Seções">
      {nav.map(([href, label]) => <a href={href} class="transition-colors hover:text-white">{label}</a>)}
    </nav>
    <a href={whatsappUrl(lp)} target="_blank" rel="noopener" class="btn-primary !min-h-10 !px-4 text-sm sm:!px-5">
      <Icon name="whatsapp" class="size-4" /><span class="hidden sm:inline">{cta}</span><span class="sm:hidden">WhatsApp</span>
    </a>
  </div>
</header>
