---
import type { LandingPage } from '../../lib/lp';
const { steps } = Astro.props as { steps: LandingPage['steps'] };
---
<section class="mx-auto max-w-6xl px-5 py-20">
  <p data-reveal class="text-sm font-semibold uppercase tracking-[.2em] text-glow">Como começar</p>
  <h2 data-reveal style="--d:1" class="mt-3 text-4xl font-bold sm:text-5xl">Três passos. Sem complicação.</h2>
  <ol class="relative mt-12 grid gap-4 md:grid-cols-3">
    {steps.map((s, i) => (
      <li data-reveal style={`--d:${i}`} class="glass relative rounded-3xl p-8">
        <span class="font-display text-6xl font-extrabold text-transparent [-webkit-text-stroke:1px_var(--brand)]">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="mt-4 text-xl font-semibold">{s.title}</h3>
        <p class="mt-2 text-white/60">{s.text}</p>
      </li>
    ))}
  </ol>
</section>
