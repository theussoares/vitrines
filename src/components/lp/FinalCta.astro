---
import type { LandingPage } from '../../lib/lp';
import { whatsappUrl } from '../../lib/lp';
import Icon from '../Icon.astro';
const { lp } = Astro.props as { lp: LandingPage };
---
<section id="contato" class="mx-auto max-w-6xl px-5 py-20">
  <div data-reveal class="grain relative isolate overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-brand via-brand to-brand-deep px-6 py-16 text-center sm:px-16 sm:py-24">
    <div class="absolute -right-20 -top-20 -z-10 size-96 rounded-full bg-white/20 blur-[90px]" aria-hidden="true"></div>
    <h2 class="mx-auto max-w-3xl text-4xl font-extrabold sm:text-6xl">{lp.finalCta.title}</h2>
    <p class="mx-auto mt-5 max-w-xl text-lg text-white/85">{lp.finalCta.text}</p>
    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href={whatsappUrl(lp)} target="_blank" rel="noopener" class="inline-flex min-h-14 items-center gap-3 rounded-full bg-white px-8 font-semibold text-brand-deep shadow-2xl transition-transform duration-300 hover:-translate-y-1 hover:scale-105">
        <Icon name="whatsapp" class="size-5" />{lp.finalCta.button}
      </a>
      <span class="text-white/85">{lp.whatsapp.display}</span>
    </div>
  </div>
</section>
