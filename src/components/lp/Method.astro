---
import type { LandingPage } from '../../lib/lp';
import Icon from '../Icon.astro';
const { method, eyebrow = 'Metodologia' } = Astro.props as { method: LandingPage['method']; eyebrow?: string };
---
<section id="metodo" class="mx-auto max-w-6xl px-5 py-20">
  <div class="max-w-2xl">
    <p data-reveal class="text-sm font-semibold uppercase tracking-[.2em] text-glow">{eyebrow}</p>
    <h2 data-reveal style="--d:1" class="mt-3 text-4xl font-bold sm:text-5xl">{method.title}</h2>
    <p data-reveal style="--d:2" class="mt-5 text-lg text-white/60">{method.text}</p>
  </div>
  <div class="mt-12 grid gap-4 md:grid-cols-3">
    {method.items.map((it, i) => (
      <article data-reveal style={`--d:${i}`} class="spot glass rounded-3xl p-7">
        <span class="grid size-12 place-items-center rounded-2xl bg-brand/15 text-glow ring-1 ring-brand/40"><Icon name={it.icon} class="size-6" /></span>
        <h3 class="mt-6 text-xl font-semibold">{it.title}</h3>
        <p class="mt-3 text-white/60">{it.text}</p>
      </article>
    ))}
  </div>
</section>
